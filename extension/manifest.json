{
  "manifest_version": 3,
  "name": "企查查速查助手",
  "version": "1.2.0",
  "description": "企查查插件查询入口：自动登录、单窗口标签管理，Mac / Windows 通用",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://ims.allbrightlaw.com/*",
    "https://pro-plugin.qcc.com/*",
    "https://www.qcc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开企查查速查",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://pro-plugin.qcc.com/*"],
      "js": ["content/guard-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://pro-plugin.qcc.com/*"],
      "js": ["content/bridge.js", "content/qcc-page.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.qcc.com/*"],
      "js": ["content/guard-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.qcc.com/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://ims.allbrightlaw.com/*"],
      "js": ["content/ims-login.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
